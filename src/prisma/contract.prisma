// use prisma-8

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  phone        String?
  institution  String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}
